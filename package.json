{
  "name": "@airtable/mcp-cli",
  "version": "0.2.5",
  "description": "Airtable MCP CLI — auto-discovers commands from the MCP server",
  "bin": {
    "airtable-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "link": "npm run build && npm link"
  },
  "files": [
    "dist"
  ],
  "engines": {
