  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Airtable/airtable-mcp-cli.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "clipanion": "^4.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
